# Settings for the contact page's survey form (lib/surveyEmail.ts).
# Copy this file to .env.local for local testing, and add the same names in
# your host's settings (Vercel: Project > Settings > Environment Variables;
# Cloudflare: the Worker's Variables and Secrets). Never commit real keys.

# Required. From resend.com > API Keys. Without it, the form logs requests in
# local development and shows "couldn't send, please call" everywhere else.
RESEND_API_KEY=

# Who the emails come from. Defaults to "ERS Energy <info@ersenergy.co.uk>",
# which only works once ersenergy.co.uk is verified in Resend.
# While testing on a Resend account with no domain set up, use:
#   SURVEY_EMAIL_FROM=ERS Energy <onboarding@resend.dev>
SURVEY_EMAIL_FROM=

# Who gets each request: one address, or several separated by commas.
# Defaults to info@ersenergy.co.uk.
# While testing, use the address you signed up to Resend with: until a domain
# is verified, Resend only delivers to that address.
SURVEY_EMAIL_TO=

# Where a customer's reply to their confirmation goes. Defaults to
# info@ersenergy.co.uk.
SURVEY_EMAIL_REPLY_TO=

# The website the emails link to and load their logo from. Defaults to the
# site's Vercel address while it's on Vercel, otherwise https://ersenergy.co.uk.
# When testing locally, set it to a deployed copy of the site: an inbox can't
# load the logo from localhost.
#   SURVEY_EMAIL_SITE_URL=https://ers-energy-website.vercel.app
SURVEY_EMAIL_SITE_URL=
